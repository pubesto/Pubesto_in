# ── Core ──────────────────────────────────────────────────────────────────────
# PostgreSQL connection string (Neon, Supabase, RDS, or your own server).
DATABASE_URL=postgresql://pubesto@127.0.0.1:5434/pubesto
# Public URL of the site. Used for login cookies, email links and Google sign-in.
BETTER_AUTH_URL=https://www.pubesto.com
NEXT_PUBLIC_SITE_URL=https://www.pubesto.com
# Generate with: openssl rand -base64 32   (keep it secret; changing it signs everyone out)
BETTER_AUTH_SECRET=
STORE_NAME=Pubesto
STORE_SUPPORT_EMAIL=support@pubesto.com

# ── Payments (Razorpay) ───────────────────────────────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=
# Razorpay Dashboard → Webhooks → https://www.pubesto.com/api/webhooks/razorpay
# events: payment.captured, order.paid. Creates the order even if the shopper closes the tab.
RAZORPAY_WEBHOOK_SECRET=

# ── Google sign-in ────────────────────────────────────────────────────────────
# Authorised redirect URI (unchanged from before): https://www.pubesto.com/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Image uploads (Cloudflare R2) — required in production for dashboard uploads ──
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=pubesto-media
R2_PUBLIC_URL=https://media.pubesto.com

# ── Email (order confirmations, password reset, admin alerts) ────────────────
EMAIL_FROM="Pubesto <orders@pubesto.com>"
EMAIL_REPLY_TO=support@pubesto.com
ADMIN_NOTIFICATION_EMAIL=
# Either Resend…
RESEND_API_KEY=
# …or any SMTP account (Google Workspace, Zoho, Hostinger…)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false

# ── WhatsApp notifications (optional, Meta WhatsApp Cloud API) ───────────────
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_ADMIN_NUMBER=

# ── Meta Conversions API ──────────────────────────────────────────────────────
META_PIXEL_ID=
META_CAPI_ACCESS_TOKEN=
META_CAPI_TEST_EVENT_CODE=

# ── Analytics & recordings (dashboard → Analytics) ───────────────────────────
NEXT_PUBLIC_RECORDING_SAMPLE_RATE=100
MAINTENANCE_SECRET=
RECORDING_RETENTION_DAYS=30
ANALYTICS_RETENTION_DAYS=180

# ── One-time Shopify import (npm run import:shopify). Remove after go-live. ──
SHOPIFY_STORE_DOMAIN=
SHOPIFY_ADMIN_ACCESS_TOKEN=

# ── Staff (npm run admin:promote) ────────────────────────────────────────────
ADMIN_EMAIL=
